# AWS Configuration (Using your $100 AWS Credit)
# Recommended region for Indian creators: ap-south-1 (Mumbai) or us-east-1
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=vibecut-uploads

# Free Groq API Key for Whisper Transcription (Free tier from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
